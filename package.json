{
  "name": "switch-profile",
  "version": "2.3.0",
  "main": "index.js",
  "bin": {
    "switch-profile": "index.js"
  },
  "description": "Switch between AWS profiles from your terminal: fuzzy search, SSO login (device code over SSH), per-terminal AWS_PROFILE and tab-completion.",
  "keywords": [
    "aws",
    "aws-cli",
    "aws-sso",
    "iam-identity-center",
    "profile",
    "sso",
    "cli",
    "device-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasdao/switch-profile.git"
  },
  "bugs": {
    "url": "https://github.com/nicolasdao/switch-profile/issues"
  },
  "homepage": "https://github.com/nicolasdao/switch-profile#readme",
  "scripts": {
    "build": "esbuild src/cli.js --bundle --platform=node --target=node20.12 --format=cjs --minify-syntax --legal-comments=none --outfile=dist/cli.js",
    "dev": "node index.js",
    "lint": "eslint . --fix",
    "test": "mocha --exit",
    "test:dist": "npm run build && SWITCH_PROFILE_DIST=1 mocha --exit test/cli.js",
    "prepublishOnly": "npm run lint && npm test && npm run test:dist",
    "v": "node -e \"console.log(require('./package.json').version)\""
  },
  "author": "Nicolas Dao",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "@eslint/js": "^10.0.1",
    "chai": "^4.1.2",
    "commander": "^14.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "fuzzysort": "^3.1.0",
    "globals": "^17.13.0",
    "mocha": "^11.8.0",
    "uqr": "^0.1.3"
  },
  "files": [
    "index.js",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  }
}
